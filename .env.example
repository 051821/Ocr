# Environment Configuration Template (Sanitized - No secrets)

# Application Flags (Default OFF)
ENABLE_HARDENED_CONFIG=false
ENABLE_ANONYMIZED_AUDIT_LOGS=false
ENABLE_CHAT_OUTPUT_SANITIZER=false
ENABLE_STRICT_HTML_SANITIZATION=false

# Audit Hash Salt (Used when ENABLE_ANONYMIZED_AUDIT_LOGS=true)
AUDIT_HASH_SALT=example_random_audit_salt_minimum_32_chars

# External LLM API Gateway
OPENROUTER_API_KEY=your_openrouter_api_key_here

# PostgreSQL Clinical Store (Read-Only)
DATABASE_URL=postgresql://user:password@hostname:5432/dbname
DB_POOL_MIN=2
DB_POOL_MAX=10

# Neo4j Graph Store (Optional)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
