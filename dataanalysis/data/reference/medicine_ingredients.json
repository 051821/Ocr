  "_forms_doc": "Dose-form words in a prescription line and the route they state.",
  "forms": {
    "topical": "gel|cream|oint(?:ment)?|lotion|spray|patch|soap|powder|dusting|shampoo|paste|liniment|emulgel",
    "oral": "tab(?:let)?s?|cap(?:sule)?s?|syp|syr(?:up)?|susp(?:ension)?|sachet|granules",
    "injection": "inj(?:ection)?",
    "drops": "drops?|eye\\s+drops?|ear\\s+drops?",
    "inhaled": "inhaler|rotacaps?|respules?|nebuli[sz]er|neb"
  },
  "_oral_prefixes_doc": "Abbreviations that mean tablet only as the first word of a line ('Ta Telmisartan', 'T. Telma').",
  "oral_prefixes": [
    "ta",
    "t",
    "tb"
  ],
  "_template_doc": "Route of a line written without a form ('Diclofenac'): taken from another prescription in the same record that holds the same product with a written form and nearly the same other products (Jaccard similarity of the other products >= min_similarity, at least min_shared of them).",
  "template_inference": {
    "min_similarity": 0.75,
    "min_shared": 2
  },
