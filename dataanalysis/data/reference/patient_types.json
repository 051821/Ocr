    {"name": "Skin / Hair", "exercise": "neutral",
     "pattern": "eczema|dermat|tinea|t\\.\\s*corporis|xerosis|acne|pimple|scabies|melasma|urticari|\\bpmle\\b|\\bacd\\b|\\bsd\\b|impetigo|follicul|p\\.?\\s*alba|pityriasis|psoria|vitiligo|white\\s*spot|itch|fung|boil|furuncl|hair\\s*fall|hairfall|alopecia|telogen|onycho|kerato|intertrigo|crack\\s*heel|mil+i(?:a|ar|ria)|skin|wart|ringworm|rash|pigment"},
    {"name": "Women's health", "exercise": "benefit",
