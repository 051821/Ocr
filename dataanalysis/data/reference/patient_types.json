{
  "_doc": "Body-system patient types (clusters). Each pattern is matched (case-insensitive) against a visit's diagnoses and chief complaint. A visit or patient can match several types; the highest-scoring one is the cluster. exercise is the cluster rule: 'benefit' (regular exercise helps), 'neutral' (no specific benefit, no harm) or 'avoid' (acute illness/injury: rest until recovered; only blocks exercise while current). Add or edit entries here without code changes.",

  "negation_pattern": "\\b(?:no|nil|without|r/o|rule\\s*out)\\s+\\w+",

  "types": [
    {"name": "Neurological", "exercise": "benefit",
     "pattern": "headache|migrain|vertigo|dizz|giddi|neuropath|neuralgi|tingling|numbness|seizur|epilep|convuls|\\bphn\\b|post\\s*herpetic|radicul|\\brad\\b|myelopath|sciatica|paralys|stroke|\\bcva\\b|palsy|tremor|parkinson|syncope"},
    {"name": "Mental health / Stress", "exercise": "benefit",
     "pattern": "anxiety|depress|stress|tension(?!\\s*(?:type\\s*)?headache)|insomnia|sleep|panic|psych|\\bocd\\b|bipolar|schizo|alcohol|addiction"},
    {"name": "Musculoskeletal", "exercise": "benefit",
     "pattern": "joint|knee|\\boa\\b|osteoarth|arthr|\\bdjd\\b|spondyl|back\\s*(?:ache|pain)|backache|\\blba\\b|\\blbp\\b|lumbago|lumbar|cervical\\s*(?:pain|spondy)|neck\\s*pain|shoulder|myalg|mayalg|myofascial|body\\s*(?:pain|ache)|bodyache|leg\\s*pain|hand\\s*pain|foot\\s*pain|heel\\s*pain|plantar|waist\\s*pain|\\bra\\b|rheumat|gout|sprain|orthop|frozen"},
    {"name": "Respiratory", "exercise": "neutral",
     "pattern": "\\burti\\b|\\blrti\\b|\\buri\\b|upper\\s*resp|lower\\s*resp|cough|\\bcold\\b|\\bflu\\b|influenza|asthma|\\bcopd\\b|bronch|pneumon|wheez|breath|\\btb\\b|tubercul"},
    {"name": "ENT", "exercise": "neutral",
     "pattern": "\\bear\\b|\\bcsom\\b|\\bwax\\b|otitis|throat|pharyng|tonsil|sinus|rhinit|\\bent\\b|epistaxis|hearing"},
    {"name": "Fever / Infection", "exercise": "avoid",
     "pattern": "\\bafi\\b|fever|febrile|viral|dengue|malaria|typhoid|enteric|varicella|chicken\\s*pox|herpes|zoster|measles|mumps"},
    {"name": "Cardiovascular", "exercise": "benefit",
     "pattern": "\\bhtn\\b|\\bht\\b|hypertens|\\bbp\\b|blood\\s*pressure|\\bcad\\b|\\bihd\\b|coronar|angina|chest\\s*pain|heart|cardi|dyslipid|cholesterol|hypotension|palpitat|edema|oedema"},
    {"name": "Diabetes / Endocrine", "exercise": "benefit",
     "pattern": "\\bt2dm\\b|\\bdm\\b|diabet|sugar|thyroid|hypothyr|hyperthyr|endocrin|obes"},
    {"name": "Gastrointestinal", "exercise": "benefit",
